# WakeMATE Companion is a config-file-based app (see wakemate.config.example.json
# for the actual runtime settings: bind address, discovery, pairing/token
# storage, capability flags). There is no secrets-bearing .env file to fill
# in -- the only environment variable the process reads is the standard
# Rust logging filter below, which never contains a secret.

# Controls log verbosity. Same syntax as any tracing-subscriber EnvFilter,
# e.g. "info", "debug", "wakemate_companion=debug,tower_http=info".
# Never put the pairing token or other secrets in this value; nothing here
# is ever included in log output regardless.
RUST_LOG=info
